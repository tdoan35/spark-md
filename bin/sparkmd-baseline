#!/usr/bin/env bash
# Demo baseline = the registry + outbox exactly as humans left them (e.g. Joyce's real review of 100005 T0).
#   bin/sparkmd-baseline save      snapshot (refuses while a replay runs or if the hero 134503 is in the registry)
#   bin/sparkmd-baseline restore   demo reset (returns the hero's DICOM to the backlog), then put the snapshot back
# Never creates confirmations, approvals or reports: it only copies what was already there.
# The worker is restarted for the copy (sqlite file swap), which also re-baselines the network counters.
set -uo pipefail
here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
. "$here/sparkmd-lib.sh"
API=${SPARKMD_API:-http://127.0.0.1:8100}
SNAP="$SPARKMD_HOME/baseline"
post() { curl -s -m 30 -X POST "$API$1" -H 'Content-Type: application/json' -d "$2"; }
log() { printf '%s %s\n' "$(date +%H:%M:%S)" "$*"; }
health() { for _ in $(seq 1 90); do curl -s -m 2 "$API/api/health" >/dev/null && return 0; sleep 1; done; return 1; }
stop_worker() { "$here/sparkmd-stop" --only worker >/dev/null 2>&1; for _ in $(seq 1 45); do curl -s -m 1 "$API/api/health" >/dev/null || return 0; sleep 1; done; return 1; }
start_worker() { "$here/sparkmd-start" --only worker >/dev/null 2>&1; health; }

case "${1:-}" in
save)
  st=$(curl -s -m 3 "$API/api/demo/state") || { log "FAIL worker not answering"; exit 1; }
  [[ "$st" == *'"replaying":true'* || "$st" == *'"replaying": true'* ]] && { log "FAIL a replay is running"; exit 1; }
  curl -s -m 5 "$API/api/worklist" | grep -q '"134503"' && { log "FAIL hero 134503 is in the registry (reset first)"; exit 1; }
  log "stopping worker for a consistent copy"; stop_worker || { log "FAIL worker did not stop"; exit 1; }
  rm -rf "$SNAP.tmp" && mkdir -p "$SNAP.tmp" && cp -a "$SPARKMD_HOME"/registry.sqlite* "$SNAP.tmp/" && cp -a "$SPARKMD_HOME/outbox" "$SNAP.tmp/outbox" \
    && rm -rf "$SNAP" && mv "$SNAP.tmp" "$SNAP" && date -Is > "$SNAP/saved_at" || { log "FAIL copy"; start_worker; exit 1; }
  log "saved to $SNAP"; start_worker && log "OK worker back up" || { log "FAIL worker did not come back"; exit 1; } ;;
restore)
  [[ -f "$SNAP/registry.sqlite" ]] || { log "FAIL no baseline at $SNAP (run save first)"; exit 1; }
  post /api/demo/stop '{}' >/dev/null
  post /api/demo/reset '{}' >/dev/null || { log "FAIL reset"; exit 1; }
  log "reset done; stopping worker to restore the snapshot"; stop_worker || { log "FAIL worker did not stop"; exit 1; }
  rm -f "$SPARKMD_HOME"/registry.sqlite-wal "$SPARKMD_HOME"/registry.sqlite-shm
  cp -a "$SNAP"/registry.sqlite* "$SPARKMD_HOME/" && rm -rf "$SPARKMD_HOME/outbox" && cp -a "$SNAP/outbox" "$SPARKMD_HOME/outbox" \
    || { log "FAIL restore copy"; start_worker; exit 1; }
  start_worker && log "OK baseline restored (saved $(cat "$SNAP/saved_at" 2>/dev/null))" || { log "FAIL worker did not come back"; exit 1; } ;;
*) echo "usage: $0 save|restore"; exit 2 ;;
esac
